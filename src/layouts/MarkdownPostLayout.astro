---
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;
---

<Layout>
  <section class="relative w-full min-h-[90vh] p-3 md:p-6 text-black dark:text-white">
  <article
    class="prose prose-lg dark:prose-invert mx-auto max-w-4xl
           prose-p:my-6
           prose-headings:mt-10 prose-headings:mb-5
           prose-h2:text-3xl
           prose-h3:text-2xl"
  >
    <h1 class="text-center !text-4xl">{frontmatter.title}</h1>
    <slot />
  </article>
</section>
</Layout>