---
import { Image } from "astro:assets";
const { title, desktopHero, mobileHero } = Astro.props;
---
<section class="relative w-full h-[90vh] flex items-center justify-center text-center text-white">
    <!-- Background Image -->
     <Image
  src={desktopHero}
  alt={title}
  class="hidden md:block absolute inset-0 w-full h-full object-cover"
/>

<Image
  src={mobileHero}
  alt={title}
  class="block md:hidden absolute inset-0 w-full h-full object-cover"
/>
    <!-- Overlay -->
     <div class="absolute inset-0 bg-black/20"></div>

     <!-- Content -->
      <div class="relative z-10 px-4 text-center dark:text-dark-special-yellow text-special-yellow">
        <slot />
      </div>
</section>