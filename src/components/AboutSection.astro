---
import { Image } from "astro:assets";
import Hero from "./Hero.astro";
import mainHero from "../images/top.jpeg";
import mobileMainHero from "../images/topMobile.jpeg"
import sideImage from "../images/sideImage.jpeg";
---

<>
  <Hero
    desktopHero={mainHero}
    mobileHero={mobileMainHero}
    title="Web Apps for You! Photo taken at Caphe Roasters by Leigh Michael Forrest"
  >
    <div class="hero-text m-2">Web Apps and Data for You</div>
    <button
      id="heroButton"
      class="bg-special-yellow dark:bg-dark-special-yellow text-vermillion dark:text-dark-vermillion rounded-xl p-3"
      >Learn More</button
    >
  </Hero>
  <section
    id="about"
    class="grid grid-cols-1 md:grid-cols-2 gap-6 p-6 items-stretch min-h-100"
  >
    <div class="min-h-100 md:h-full flex flex-col justify-start items-center">
      <h2 class="text-2xl text-center m-6">About Us</h2>
      <p>
        I build full-stack web applications with Python, Django, and React —
        from database design and backend logic to polished user interfaces.
        Along the way, I work with tools like Docker, PostgreSQL, Pandas, and
        Python’s data stack to build applications that turn ideas and
        information into useful software. I’m based in Philadelphia, working
        independently with clients locally and remotely. I bring the same
        attention to detail and craftsmanship found in the city’s neighborhoods
        and small businesses to the software I build.
      </p>
    </div>
    <div class="h-full">
      <Image
        src={sideImage}
        inferSize={true}
        alt="About Gripweed Consulting: Race St. Pier image by Leigh Michael Forrest"
        class="w-full h-full object-cover"
      />
    </div>
  </section>
</>
